@model Lab3_HienThiSanPham.ViewModel.LoginViewModel

@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white text-center">
                <h4 class="mb-0">ĐĂNG NHẬP HỆ THỐNG</h4>
            </div>
            <div class="card-body p-4">
                <form asp-controller="Account" asp-action="Login"
                      asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">

                    <!-- Hiển thị lỗi chung (ví dụ: Sai email hoặc mật khẩu) -->
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="UserNameOrEmail" class="form-label fw-semibold"></label>
                        <input asp-for="UserNameOrEmail" class="form-control" placeholder="Nhập email hoặc tên đăng nhập" />
                        <span asp-validation-for="UserNameOrEmail" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold"></label>
                        <input asp-for="Password" class="form-control" placeholder="Nhập mật khẩu" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label"></label>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary">Đăng nhập</button>
                    </div>

                    <div class="mt-3 text-center">
                        <span>Chưa có tài khoản?</span>
                        <a asp-controller="Account" asp-action="Register" class="text-decoration-none">Đăng ký ngay</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}